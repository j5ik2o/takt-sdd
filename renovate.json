{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep Node.js and its type definitions on the supported 24.x line",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "description": "Keep the TypeScript compiler on the supported 6.x line",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "6.x"
    }
  ]
}
